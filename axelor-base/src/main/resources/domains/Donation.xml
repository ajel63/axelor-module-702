<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_6.1.xsd">

  <module name="base" package="com.axelor.apps.base.db"/>

  <entity name="Donation">

    <string name="fullName" title="Full Name" required="true"/>
    <string name="phoneNumber" title="Phone Number"/>
    <string name="email" title="Email Address"/>
    <string name="eventCity" title="Event City" selection="status-donation-event-city-select"/>
    <string name="donationPurpose" title="Donation Purpose"
      selection="status-donation-purpose-select"/>
    <string name="donationPurposeNote" title="Donation Purpose (Note)"/>
    <decimal name="amount" title="Donation Amount"/>
    <string name="paymentMethod" title="Payment Method"
      selection="status-donation-payment-method-select"/> <!-- Cash Bank Paypal Other -->
    <integer name="statusSelect" title="Status" selection="status-donation-status-select"/>
    <string name="notes" title="Notes" large="true"/>
    <date name="paidDate" title="Paid Date"/>
    <boolean name="isAnonymous" title="Anonymous Donation"/>
    <many-to-one name="receipt" ref="com.axelor.meta.db.MetaFile" title="Receipt"
      index="false"/>

  </entity>

</domain-models>
