            <xml-property name="queryText"><![CDATA[select Donation.id as Id,
Donation.full_name as FullName,
Donation.email as EMail,
Donation.phone_number as Phone,
Donation.amount as Amount,
Donation.paid_date as PaidDate,
Donation.status_select as status,
Donation.is_anonymous as IsAnonymous,
Donation.event_city as EventCity,
Donation.donation_purpose_note as DonationPurposeNote,
Donation.donation_purpose as DonationPurpose,
Donation.payment_method as PaymentMethod,
Donation.notes as notes 

from base_donation as Donation

where Donation.id = ?
]]></xml-property>
