<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_6.1.xsd">

  <module name="sale" package="com.axelor.apps.sale.db"/>

  <entity name="PaymentRefundLine">

    <string name="paymentMode" title="Payment Mode"/>
    <string name="paymentReference" title="Payment Reference"/>
    <decimal name="amount" title="Amount Recived"/>
    <string name="notes" title="Notes"/>

    <many-to-one ref="com.axelor.apps.sale.db.SaleOrder" name="saleOrder"
      title="SaleOrder"/>

  </entity>

</domain-models>
